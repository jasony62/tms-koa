    "dist"
  ],
  "dependencies": {
    "@koa/cors": "5.0.0",
    "@koa/router": "15.7.0",
    "@log4js-node/log4js-api": "^1.0.2",
    "agenda": "^6.2.5",
    "dayjs": "1.11.21",
    "debug": "4.4.3",
    "dotenv-flow": "4.1.0",
    "fs-extra": "11.3.6",
    "glob": "13.0.6",
    "jsonwebtoken": "^9.0.3",
    "koa": "3.2.1",
    "koa-body": "^8.0.0",
    "koa-send": "5.0.1",
    "koa-static": "^5.0.0",
    "lodash": "4.18.1",
    "mongodb": "^7.4.0",
    "prom-client": "15.1.3",
    "socket.io": "4.8.3",
